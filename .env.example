# Пример переменных окружения. На BotHost их вписывают в панели (раздел «Переменные окружения»),
# а НЕ в этот файл. Этот файл — только подсказка, реальные значения в git не коммить!

# Токен Telegram-бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAH_your_token_here

# Пароль для входа в бота: /start → ввести пароль (обязательно, если не задан ADMIN_IDS)
ADMIN_PASSWORD=придумай_сложный_пароль

# Твой Telegram ID (узнать: @userinfobot). С ним ты сразу админ без ввода пароля.
ADMIN_IDS=123456789

# golden_key с funpay.com (cookies). Можно не задавать и прислать боту в Telegram.
GOLDEN_KEY=

# Прокси (необязательно): login:pass@ip:port
FUNPAY_PROXY=

# User-Agent твоего браузера (необязательно, есть стандартный)
USER_AGENT=

# Папка постоянного хранилища, если хостинг его даёт (необязательно)
DATA_DIR=
